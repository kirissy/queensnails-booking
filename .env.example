# Supabase — create a project at https://supabase.com, run the SQL files in
# supabase/migrations/ against it (SQL Editor or `supabase db push`), then
# fill these in from Project Settings > API. Until these are set, the app
# runs entirely on mock data (see src/lib/mock-data.ts).
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Service role key — server-only, never expose to the browser. Used by the
# booking API route to atomically claim a slot before the customer has a
# session, and by cron routes.
SUPABASE_SERVICE_ROLE_KEY=

# Google Calendar — create an OAuth client (type "Web application") in
# https://console.cloud.google.com, enable the Google Calendar API, and add
# GOOGLE_REDIRECT_URI as an authorized redirect URI on that client. Then, as
# the studio owner, sign in and visit /api/google/connect once to grant
# access — the refresh token is stored in the studio_settings table.
# Optional: without these, bookings still work, just without calendar sync.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:3000/api/google/callback

# Resend — https://resend.com, verify a sending domain, create an API key.
# Optional: without this, emails are skipped (logged to the server console).
RESEND_API_KEY=
RESEND_FROM_EMAIL="Queensnails <booking@yourdomain.com>"
# Where "new proof submitted" and cancellation/no-show alerts go.
OWNER_EMAIL=

# Used in email links back to the admin dashboard.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Shared secret for the two scheduled jobs in vercel.json (Vercel Cron sends
# this automatically as `Authorization: Bearer $CRON_SECRET` once the env var
# is set on the project). Generate any random string.
CRON_SECRET=

# Instagram — requires a Meta Developer app with the Instagram API product,
# the studio's Instagram account converted to a professional (Business or
# Creator) account, and a long-lived access token generated for it via
# https://developers.facebook.com/docs/instagram-platform/instagram-api-with-instagram-login.
# Optional: without this, the homepage shows placeholder tiles instead of
# real posts — everything else still works.
INSTAGRAM_ACCESS_TOKEN=
